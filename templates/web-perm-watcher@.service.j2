# {{ ansible_managed }}
[Unit]
Description=Real-time perm-watcher for %i web dir (supplements s3-uploads-sync)
After=network-online.target

[Service]
Type=simple
ExecStart={{ bin_dir }}/web-perm-watcher.sh "{{ web_dir }}" "{{ web_group }}" "{{ web_group }}"
Restart=always
RestartSec=3
MemoryMax=128M
CPUWeight=30
Nice=10

ProtectSystem=strict
ReadWritePaths={{ web_dir_readwrite_paths }}
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
